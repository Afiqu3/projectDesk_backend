      "item": [
        {
          "name": "Register Student",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registration returns 201', function () { pm.response.to.have.status(201); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.accessToken) { pm.collectionVariables.set('studentAccessToken', body.data.accessToken); }",
                  "if (body.data && body.data.refreshToken) { pm.collectionVariables.set('studentRefreshToken', body.data.refreshToken); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{studentName}}\",\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{studentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
